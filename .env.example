# Copy to .env and fill in. Nothing here is required for the mock pipeline:
# the replay agent, the deterministic checks, the guardrail demo, and the unit
# tests all run with this file absent.

# Needed only for --agent claude and for --judge.
ANTHROPIC_API_KEY=

# Model used by the agent under test. Must be a model the account can access.
# A mid-tier model is enough for these tasks and cheaper across repeated runs.
AGENT_MODEL=claude-sonnet-5

# Model used by the rubric judge. Can differ from the agent model.
JUDGE_MODEL=claude-sonnet-5

# Adaptive thinking for the agent under test. Off by default: the tasks do not
# need reasoning, and running without it is faster and cheaper. Set to "adaptive"
# to enable.
AGENT_THINKING=off

# Token ceiling per model call. A cap, not a target: only generated tokens are
# billed. Too low truncates answers and breaks the judge's JSON.
MAX_TOKENS=16000

# Runs per task for the claude agent. The agent is non-deterministic, so a task
# passes the gate only if every repetition passes.
REPETITIONS=3

# Where reports are written.
REPORTS_DIR=reports
